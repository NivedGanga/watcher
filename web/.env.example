# AgentWatch web app configuration. Copy to .env.local (gitignored) and fill in.
# All values are public — they ship in the browser bundle.

# Origin of the AgentWatch API (no trailing slash).
VITE_API_BASE_URL=https://api.alerts.example.com

# Firebase web app config: Firebase console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Web Push certificate public key: Firebase console → Project settings →
# Cloud Messaging → Web Push certificates → Generate key pair.
VITE_FCM_VAPID_KEY=
